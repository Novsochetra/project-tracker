{
  "name": "project-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @tracker/server\" \"npm run dev -w @tracker/web\"",
    "build": "npm run build -w @tracker/web && npm run build -w @tracker/server && npm run build -w @tracker/agent",
    "start": "npm run start -w @tracker/server",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run check:first-load",
    "check:first-load": "tsx scripts/check-first-load.ts",
    "prepare": "husky",
    "seed": "tsx scripts/seed.ts",
    "owner:set": "npm run owner:set -w @tracker/server --",
    "db:migrate": "tsx apps/server/src/db/cli.ts migrate",
    "db:rollback": "tsx apps/server/src/db/cli.ts rollback",
    "db:status": "tsx apps/server/src/db/cli.ts status",
    "data:move": "tsx apps/server/src/cli/moveData.ts",
    "test:e2e:clean": "bash scripts/e2e-clean.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
