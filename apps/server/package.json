{
  "name": "@tracker/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "owner:set": "tsx src/cli/setOwner.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:s3": "TRACKER_S3_SMOKE=1 vitest run test/smoke/s3.smoke.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/lib-storage": "^3.1148.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@tracker/shared": "*",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "image-size": "^2.0.4",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tracker/client": "*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "kysely-pglite": "^0.6.1",
    "tsup": "^8.5.1"
  }
}
