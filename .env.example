# Every variable the tracker's server reads, with what it means. Never commit real values.
# The server reads only its environment (nothing loads this file): on Railway set them as the
# service's Variables (docs/deploy-railway.md); locally export them or pass them on the command line.
# [Railway: required] = the server refuses to start on Railway without it.
# [Railway: automatic] = Railway or the server sets it on Railway; setting it yourself is harmless.

# --- Server ---------------------------------------------------------------------------------
# production makes the session cookie Secure on every request. Unset locally.
# [Railway: automatic] (Railpack sets production)
NODE_ENV=
# Port to listen on. Default 4100. [Railway: automatic] (Railway sets PORT)
PORT=
# Interface to listen on. Default 127.0.0.1 (this machine only). [Railway: automatic] 0.0.0.0
HOST=
# How many proxies in front add to X-Forwarded-For: sign-in limits then count the client's
# address, and X-Forwarded-Proto: https counts. Default 0. [Railway: automatic] 1
TRUST_PROXY=
# The tracker's public address, shown to agents in Connect Claude Code. Default: the address a
# request reached. [Railway: automatic] https://<RAILWAY_PUBLIC_DOMAIN>
PUBLIC_URL=
# Folder with the built web app the server serves. Default apps/web/dist.
WEB_DIST=

# --- Database (docs/architecture.md 2.1) ----------------------------------------------------
# postgres://… or a SQLite file path. Default data/tracker.db.
# [Railway: required] ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Postgres connections in the pool. Default 10.
DATABASE_POOL_MAX=
# Longest a query may run, in ms (0 = no limit). Default 30000. Migrations have none.
DATABASE_STATEMENT_TIMEOUT_MS=
# SSL when the URL has no sslmode: require (encrypt, don't verify; Railway's public address),
# verify-full, or disable. Default: none.
PGSSLMODE=
# 1 = migrate Postgres when the server starts; 0 = don't migrate a SQLite file on start.
# Leave unset on Railway: the pre-deploy command migrates.
MIGRATE_ON_START=

# --- Uploaded files (docs/s3-storage.md) ----------------------------------------------------
# Private S3 bucket for files. Empty keeps them in UPLOADS_DIR.
# [Railway: required] (or UPLOADS_DIR on a Railway volume)
S3_BUCKET=
# The bucket's region, such as eu-west-1. Required with S3_BUCKET.
AWS_REGION=
# Access key of an IAM user limited to the bucket. Required with S3_BUCKET. Secret.
AWS_ACCESS_KEY_ID=
# Its secret key. Required with S3_BUCKET. Secret.
AWS_SECRET_ACCESS_KEY=
# Only for an S3-compatible store (MinIO, Cloudflare R2…), not for AWS.
S3_ENDPOINT=
# Folder for files when S3_BUCKET is empty. Default data/uploads. On Railway only on a volume.
UPLOADS_DIR=

# --- Development and tests only: never set these on Railway ---------------------------------
# 1 = adds POST /api/test/reset, which deletes everything (Playwright).
TRACKER_TEST_RESET=
# Where `npm run dev`'s web server sends /api. Default http://localhost:4100.
TRACKER_API_URL=
# Any value = the web build skips its .br/.gz copies.
TRACKER_SKIP_PRECOMPRESS=
